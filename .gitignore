!ai-files/pcb/work-route/RT-1.kicad_pro
!ai-files/pcb/work-route/RT-1.kicad_dru
!ai-files/pcb/work-route/RT-1.gates.json
!ai-files/pcb/work-route/scripts/
ai-files/pcb/work-oct2/
