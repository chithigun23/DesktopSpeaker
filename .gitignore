# Local application state and disposable execution dependencies
__pycache__/
*.pyc
node_modules
*.kicad_prl
~*.lck
*.kicad_sch.lck
*.kicad_pcb.lck

# Local recovery snapshots; reviewed project history is retained in Git
ai-files/backups/
DesktopSpeaker-kicad/.history/
DesktopSpeaker-kicad/C:*
ai-files/pcb/work-p0/

# Intermediate routing/placement boards and logs (only *-final sets are tracked)
ai-files/pcb/work-r6/*
!ai-files/pcb/work-r6/R6[mnopq]-final.*
ai-files/pcb/work-r6/*.kicad_prl
ai-files/pcb/work-p1/
ai-files/pcb/work-p2/
ai-files/pcb/work-p3/
ai-files/pcb/work-review/
ai-files/pcb/work-v10/
ai-files/pcb/work-v10b/
ai-files/pcb/work-v10c/
ai-files/pcb/work-v10-review/
ai-files/pcb/work-v10b-review/
ai-files/pcb/work-v10c-review/
ai-files/pcb/work-v10d/cad/
ai-files/pcb/work-v10d/review/
ai-files/pcb/work-v10d/*.log
ai-files/helpers/*.so

# Derived CAD outputs (rebuilt by ai-files/cad/build_speaker_cad.py in seconds; FCStd, STL, renders stay tracked)
ai-files/cad/work/brep/
ai-files/cad/work/__pycache__/
ai-files/cad/__pycache__/
ai-files/cad/DesktopSpeaker_internal.step
ai-files/cad/parts/DesktopSpeaker-board.step
ai-files/cad/*.FCBak
