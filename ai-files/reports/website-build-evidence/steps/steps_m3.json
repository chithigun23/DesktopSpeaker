[{"js":"new Promise(r=>{const t0=Date.now();const f=()=>{if(V.ok||Date.now()-t0>150000)r([...document.querySelectorAll('body *')].filter(e=>e.getBoundingClientRect().width>400&&!e.closest('table')).map(e=>e.tagName+'#'+e.id+'.'+String(e.className).slice(0,20)+':'+Math.round(e.getBoundingClientRect().width)+':'+getComputedStyle(e).minWidth).slice(0,40));else setTimeout(f,500)};f()})","wait":1}]
