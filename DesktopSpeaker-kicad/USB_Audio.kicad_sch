(hierarchical_label "USB_AUDIO_R" (shape output) (at 215.9 129.54 0) (effects (font (size 1.0 1.0)) (justify right bottom)) (uuid "7a0dcb72-e8a0-4592-b9e1-b405b77186a0"))
(text "Supply: 5V_LOGIC (U14 TPS63802, 4.60-5.06 V worst case) feeds VBUS through 2.2R/1uF. DS range 4.35-5.25 V, 56 mA typ / 67 mA max, 250 uA suspend." (at 57 53.6 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "848ef1d1-a1a8-463e-8e15-2d90a1ffda9d"))
(text "Codec is powered only when 5V_LOGIC_EN is high: D+ pull-up (R173 to VDDI) = USB attach. Do not enable on DCP/unknown sources." (at 57 56.1 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "93b12c13-978d-4641-9598-3961cfa026a0"))
(text "SEL0/SEL1 = high (VDDI). HID0-2, DIN, VINL/R unused. SSPND (suspend flag, active low) reserved for a later MCU input." (at 57 58.6 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "ef2f6e07-ffb9-4b9b-97be-64f4960cf1b0"))
(text "USB_DP/USB_DN come from J1 via D1 (root). Later source-detect mux goes between those root nets and these ports." (at 57 61.1 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "77041897-11ff-45cc-a6d4-47e168823aad"))
(text "Analogue out: 0.6 VCCCI Vpp (about 2.0 Vpp, 0.7 Vrms) centred on 1.65 V; AC-coupled (HPF ~0.4 Hz at 100k), >=10k load." (at 57 173.6 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "fe60d8ce-a18a-4c61-935b-50df2d0eb3d8"))
)
